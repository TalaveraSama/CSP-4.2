# csp-cache-node — peer in the CSP cache cluster.
# Changes need: sudo systemctl restart csp-cache-node

# UDP port this peer listens on (the one other peers point at).
CACHE_PORT=54280

# Where to send our entries and pings: host:port of every peer.
# Typically CardServProxy's ClusteredCache local-port and NCam's csp_port.
CACHE_PEERS=127.0.0.1:54278,127.0.0.1:54279

# Stats endpoint the panel reads (keep it on loopback).
CACHE_HTTP_HOST=127.0.0.1
CACHE_HTTP_PORT=8099

# Seconds an ecm -> cw pair is kept, and how often we ping peers.
CACHE_MAX_AGE=19
CACHE_PING_INTERVAL=10

# Remember peers that ping us but are not listed above (1 = yes).
CACHE_AUTO_ADD_PEERS=1
