[Unit]
Description=CardServProxy (CSP)
Documentation=file:/opt/cardservproxy/README.txt
After=network-online.target ncam.service
Wants=network-online.target

[Service]
Type=simple
User=cardservproxy
Group=cardservproxy
WorkingDirectory=/opt/cardservproxy
# allowanyjvm: CardServProxy refuses to start on anything whose java.vm.name
# begins with "OpenJDK" (see CardServProxy.main, written when Sun's JVM was the
# only one worth testing against). Every JDK you can install today is OpenJDK,
# so the flag its own cardproxy.sh only mentions in a comment is now mandatory.
# networkaddress.cache.ttl replaces the Sun-only sun.net.inetaddr.ttl: it keeps
# the JVM from caching DNS forever, which matters for peers on dynamic IPs.
# The config path is passed explicitly: ProxyConfig.DEFAULT_CONFIG is
# "config/proxy.xml", relative to the working directory, which is a trap.
ExecStart=/usr/bin/java -Dcom.bowman.cardserv.allowanyjvm=true -Dnetworkaddress.cache.ttl=0 -Xmx512m -jar /opt/cardservproxy/lib/cardservproxy.jar /etc/cardservproxy/proxy.xml
Restart=always
RestartSec=5
LimitNOFILE=8192

# The proxy only needs its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/cardservproxy /etc/cardservproxy

[Install]
WantedBy=multi-user.target
