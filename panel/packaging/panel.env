# /etc/csp-panel/panel.env — configuration of the CSP/OSCam web panel.
# Restart after editing:  sudo systemctl restart csp-panel
#
# systemd parses this file: plain KEY=value, no shell expansion, no quotes needed.

# --- where the panel listens (nginx publishes it, keep it on loopback) -------
PORT=8090
HOST=127.0.0.1

# --- which softcam to manage: csp | oscam | ncam -----------------------------
BACKEND=oscam

# OSCam web interface, local or remote. In oscam.conf [webif] set
# httpport/httpuser/httppwd and add this machine's IP to httpallowed.
OSCAM_URL=http://127.0.0.1:8888

# NCam (OSCam fork). Same settings, [webif] lives in ncam.conf.
#BACKEND=ncam
#NCAM_URL=http://127.0.0.1:8888

# CardServProxy. Needs status-web (and rmi) enabled in proxy.xml.
#BACKEND=csp
#CSP_URL=http://127.0.0.1:8082

# --- try the panel without any softcam ---------------------------------------
# MOCK=1

# --- behind nginx / a TLS terminator -----------------------------------------
# auto = set the Secure cookie flag when X-Forwarded-Proto says https
SECURE_COOKIES=auto
TRUST_PROXY=loopback

# --- misc --------------------------------------------------------------------
# Accept self-signed certificates on the softcam (gen-keystore / OSCam https)
INSECURE_TLS=1
# Panel session lifetime in ms (8 h)
SESSION_TTL_MS=28800000

# --- exposed to the internet? see docs/SEGURIDAD.es.md -----------------------
# Credentials the panel uses on behalf of resellers, who have no account on
# the softcam. Needed only if you use the Resellers tab.
#BACKEND_USER=admin
#BACKEND_PASS=

# Login throttling: failures allowed, and how long the lock lasts.
#LOGIN_MAX_FAILURES=8
#LOGIN_BLOCK_MINUTES=15

# Daily digest of lines about to expire (Telegram optional).
#TELEGRAM_TOKEN=
#TELEGRAM_CHAT_ID=
#EXPIRY_WARN_DAYS=3
#EXPIRY_WARN_HOUR=9
