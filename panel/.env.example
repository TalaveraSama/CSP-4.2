# --- CSP / OSCam panel BFF configuration ------------------------------------

# Port/interface the panel listens on
PORT=8090
HOST=0.0.0.0

# Which server to talk to: csp | oscam
# (optional: inferred from whichever *_URL you set, defaults to csp)
BACKEND=csp

# --- CardServProxy backend ---
# status-web/rmi must be enabled in proxy.xml
CSP_URL=http://127.0.0.1:8082

# --- OSCam backend ---
# [webif] httpport in oscam.conf; digest auth is handled automatically
# OSCAM_URL=http://192.168.1.10:8888

# Run without any real server (synthetic data for the selected backend)
MOCK=0

# Accept self-signed certificates (CSP gen-keystore / OSCam https_auto_create_cert)
INSECURE_TLS=1

# Panel session lifetime (ms). Credentials never leave the server.
SESSION_TTL_MS=28800000

# --- Behind a reverse proxy (aaPanel/nginx, Caddy, Traefik) ---
# Secure flag of the session cookie: auto (follow the scheme) | always | never
SECURE_COOKIES=auto
# Who may set X-Forwarded-*: loopback | true | false | <ip list>
TRUST_PROXY=loopback

# Optional: serve a frontend build from somewhere else
# WEB_ROOT=/opt/csp-panel/web

# Sub-directory deployments are a BUILD time setting, not runtime:
#   BASE_PATH=/csp/ npm run build
