# --- CSP panel BFF configuration -------------------------------------------

# Port/interface the panel listens on
PORT=8090
HOST=0.0.0.0

# Base url of the CSP node http interface (status-web/rmi must be enabled in proxy.xml)
CSP_URL=http://127.0.0.1:8082

# Set to 1 to run without any CSP node at all (synthetic data, no Java required)
CSP_MOCK=0

# Accept the self-signed certificate generated by the proxy's gen-keystore command
CSP_INSECURE_TLS=1

# Panel session lifetime (ms). Credentials never leave the server.
SESSION_TTL_MS=28800000

# Optional: serve a frontend build from somewhere else
# WEB_ROOT=/opt/csp-panel/web
